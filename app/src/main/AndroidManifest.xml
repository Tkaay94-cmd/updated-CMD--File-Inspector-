<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.thirdpartyinspector">

    <!-- Minimal manifest. The app will only request runtime permissions as needed -->
    <!-- For API 29+, consider using scoped storage and Storage Access Framework for user-selected directories -->
    <!-- Do not request QUERY_ALL_PACKAGES by default; only add after clear justification. -->

    <application
        android:name=".ThirdPartyInspectorApplication"
        android:allowBackup="true"
        android:label="ThirdPartyInspector">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

    </application>

</manifest>
